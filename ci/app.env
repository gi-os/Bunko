# Per-app values for the shared pipeline in gi-os/.github (ios/README.md lists every key).
# Plain KEY="value" lines, no quotes inside values: fastlane reads this file too. No secrets.
APP_NAME="Bunko"
SCHEME="Bunko"
# target:bundle id for every target that ships (app first, then extensions)
TARGETS="Bunko:com.gios.bunko,BunkoWidget:com.gios.bunko.widget"
# Runner image for builds; "xcode-27" when the app needs the iOS 27.1 SDK.
RUNNER="xcode-27"
# Xcode version to build with (e.g. "27.1"); empty = newest non-beta on the runner.
XCODE=""
APP_GROUP="group.com.gios.bunko"
PUSH_BUNDLE=""
ICLOUD="true"
SCREENS="shelf reader closed cover obi settings shops"
THIRD_PARTY_CONTENT="false"
EXTERNAL_GROUPS=""
